<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- netstandard2.0: loaded inside Visual Studio (.NET Framework) and by the tests (modern .NET). -->
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<RootNamespace>CodeStraight.Core</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- Minimum Roslyn version: the one shipped with Visual Studio 2022 17.8. Inside VS the IDE's own Roslyn is used. -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="CodeStraight.Core.Tests" />
	</ItemGroup>

</Project>
