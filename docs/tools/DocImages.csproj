<Project Sdk="Microsoft.NET.Sdk">

	<!-- Generates the before/after samples of the documentation with the real engine. Then run render.py. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<!-- The generated samples are data, and some of them do not compile on purpose. -->
		<Compile Remove="out\**" />
		<ProjectReference Include="..\..\src\CodeStraight.Core\CodeStraight.Core.csproj" />
	</ItemGroup>

</Project>
